# ─── Mode ────────────────────────────────────────────────────────────────
# "demo"     → runs fully in the browser with persistent sample data (IndexedDB). No backend required.
# "supabase" → enables Supabase Auth/Database/Storage clients (requires the keys below).
NEXT_PUBLIC_DATA_MODE=demo

# ─── Supabase (Project Settings → API) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by scripts/seed and admin route handlers.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for listing photos (created by supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=vehicle-media

# ─── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reference exchange rate used for the optional USD display (₮ per 1 USD)
NEXT_PUBLIC_USD_RATE=3450

# ─── Optional integrations (not connected in this build) ────────────────
# Live map tiles. When empty, the built-in schematic demo map is used.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Payment gateways. When empty, payment screens are SIMULATED and process no money.
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
SOCIALPAY_TERMINAL_ID=
SOCIALPAY_SECRET=
